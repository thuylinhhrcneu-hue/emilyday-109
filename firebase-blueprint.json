{
  "entities": {
    "Subscriber": {
      "title": "Subscriber",
      "description": "Newsletter subscriber record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of subscriber",
          "maxLength": 150
        },
        "name": {
          "type": "string",
          "description": "Subscriber name or nickname",
          "maxLength": 100
        },
        "interest": {
          "type": "string",
          "description": "Primary topic of interest",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of subscription"
        }
      },
      "required": ["email", "createdAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Business partnership or collaboration inquiry",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Sender full name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Sender email",
          "maxLength": 150
        },
        "organization": {
          "type": "string",
          "description": "Company, agency, or school",
          "maxLength": 150
        },
        "serviceType": {
          "type": "string",
          "description": "Type of collaboration requested",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "description": "Detailed inquiry message",
          "maxLength": 2000
        },
        "budgetRange": {
          "type": "string",
          "description": "Estimated budget or collaboration scope",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "status": {
          "type": "string",
          "description": "Processing status (e.g. new, reviewed)",
          "maxLength": 50
        }
      },
      "required": ["name", "email", "serviceType", "message", "createdAt"]
    },
    "ArticleLike": {
      "title": "ArticleLike",
      "description": "Aggregated likes counter for a blog article",
      "type": "object",
      "properties": {
        "articleId": {
          "type": "string",
          "description": "Slug or unique ID of the article",
          "maxLength": 100
        },
        "likesCount": {
          "type": "number",
          "description": "Total counter of likes"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of latest like"
        }
      },
      "required": ["articleId", "likesCount"]
    },
    "ArticleComment": {
      "title": "ArticleComment",
      "description": "Public thought or comment left on a blog post",
      "type": "object",
      "properties": {
        "articleId": {
          "type": "string",
          "description": "Identifier of the target article",
          "maxLength": 100
        },
        "authorName": {
          "type": "string",
          "description": "Name of commenter",
          "maxLength": 100
        },
        "comment": {
          "type": "string",
          "description": "Comment text content",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of comment"
        }
      },
      "required": ["articleId", "authorName", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Subscribers list for Emily's weekly newsletter"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Client and partner collaboration inquiries"
    },
    "/article_likes/{articleId}": {
      "schema": "ArticleLike",
      "description": "Public like counts for articles"
    },
    "/article_comments/{commentId}": {
      "schema": "ArticleComment",
      "description": "Visitor reflections and comments on articles"
    }
  }
}
